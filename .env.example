# =============================================================================
# Application Environment Variables Template
# Copy this file to .env.local or .env for local development:
#   cp .env.example .env.local
# =============================================================================

# Server-Side Variables (Never exposed to the client bundle)
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/industry_db?schema=public
BACKEND_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000/api/v1
API_SECRET_KEY=your-super-secret-backend-api-key

# Client-Side Variables (Prefixed with NEXT_PUBLIC_ to be accessible in browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
